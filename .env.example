# OpenAI API Key (Get from platform.openai.com)
OPENAI_API_KEY="your_openai_api_key_here"

# ============================================
# SEARCH API KEYS (For Company Discovery)
# ============================================
# At least ONE search API key is required for discovery feature
# Multiple APIs provide failover and higher accuracy

# Tavily API Key (Recommended - Best for AI agents)
# Get from: https://tavily.com
# Free tier: 1,000 searches/month
TAVILY_API_KEY="your_tavily_api_key_here"

# SerpAPI Key (Optional - Highest accuracy, uses Google)
# Get from: https://serpapi.com
# Free tier: 100 searches/month
SERPAPI_API_KEY="your_serpapi_api_key_here"

# Brave Search API Key (Optional - Privacy-focused, independent)
# Get from: https://brave.com/search/api/
# Free tier: 2,000 searches/month (no credit card required!)
BRAVE_API_KEY="your_brave_api_key_here"
